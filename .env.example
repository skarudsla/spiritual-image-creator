# 환경 표시: development | preview | production (대시보드 배지용)
NEXT_PUBLIC_APP_ENV=development

# 남용 방어 한도 (기본값은 lib/limits.ts). 테스트 환경은 낮게.
GLOBAL_DAILY_GENERATION_CAP=50

# Supabase (Project Settings → API)
# 로컬/Preview = dev 프로젝트(싱가포르), Production = 실서버 프로젝트(도쿄) — 절대 섞지 말 것
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # service_role (secret) — 서버 전용

# Together AI (https://api.together.ai/settings/api-keys) — tgp_ 로 시작하는 비밀 키
TOGETHER_AI_API_KEY=tgp_...
# 선택: 모델 변경
# TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.2-dev
# TOGETHER_PROMPT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# TOGETHER_VISION_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct   # 결과 이미지 검수용
# OUTPUT_MODERATION=on            # off 로 두면 결과 이미지 검수 생략

# 이메일 인증/구글 로그인 링크가 되돌아올 사이트 주소 (미설정 시 요청 origin 사용)
# NEXT_PUBLIC_SITE_URL=https://spiritual-image-creator-app.vercel.app
# NEXT_PUBLIC_CONTACT_EMAIL=skarudsla@gmail.com

# 선택 (추후)
# STRIPE_SECRET_KEY=
